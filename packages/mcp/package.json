{
  "name": "@hu-apis/mcp",
  "version": "0.0.0",
  "description": "MCP server exposing Hungarian public data (MNB exchange rates, KSH statistics) to AI agents.",
  "license": "MIT",
  "author": "Hajdu Benedek",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HajduBenedek/hu-apis.git",
    "directory": "packages/mcp"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mnb",
    "ksh",
    "hungary",
    "ai-agents"
  ],
  "type": "module",
  "sideEffects": false,
  "bin": {
    "hu-apis-mcp": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup"
  },
  "dependencies": {
    "@hu-apis/core": "workspace:^",
    "@hu-apis/ksh": "workspace:^",
    "@hu-apis/mnb": "workspace:^",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
