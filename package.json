{
  "name": "hu-apis-monorepo",
  "private": true,
  "description": "Typed TypeScript clients and an MCP server for Hungarian public APIs (MNB, KSH, NAV).",
  "license": "MIT",
  "author": "Hajdu Benedek",
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "cross-env LIVE=1 vitest run --project live",
    "changeset": "changeset",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@changesets/cli": "^3.0.3",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.0.5",
    "cross-env": "^10.1.0",
    "tsup": "^9.0.0",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  }
}
